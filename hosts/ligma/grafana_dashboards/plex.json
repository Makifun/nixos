{
  "__requires": [
    {"type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0"}
  ],
  "title": "Plex",
  "uid": "plex-playma",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "5m",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Trash Cleared per Library",
      "description": "Items removed per library each trash run (15-min interval).",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 0, "spanNulls": false, "barAlignment": 0}
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum by (library) (sum_over_time({job=\"playma-plex-trash\"} | regexp `(?:INFO|WARNING|ERROR)\\s+(?P<library>[^:]+): cleared (?P<count>\\d+)` | unwrap count [20m]))",
          "legendFormat": "{{library}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Trash at Each Run",
      "description": "Total trashed items seen across all libraries per run.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "fixed", "fixedColor": "orange"},
          "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 0, "spanNulls": false, "barAlignment": 0}
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "max_over_time({job=\"playma-plex-trash\"} | regexp `total trash: (?P<total>\\d+)` | unwrap total [20m])",
          "legendFormat": "total trash",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "title": "Above Threshold Alerts",
      "description": "Libraries that hit the 50-item threshold and were NOT auto-cleared.",
      "type": "logs",
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{job=\"playma-plex-trash\"} |= \"above threshold\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "title": "Plex Trash Script Logs",
      "type": "logs",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 13},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{job=\"playma-plex-trash\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "title": "Plex Logs",
      "type": "logs",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 23},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{job=\"playma-podman-plex\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
