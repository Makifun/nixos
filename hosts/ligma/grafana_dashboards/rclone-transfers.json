    {
      "id": 3,
      "type": "stat",
      "title": "Active Transfers",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "noValue": "0",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["count"], "fields": "/^name$/", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "http://127.0.0.1:6969/core/stats",
          "url_options": { "method": "POST", "data": "" },
          "root_selector": "transferring[*]",
          "columns": [{ "selector": "name", "text": "name", "type": "string" }],
          "filters": [],
          "format": "table",
          "parser": "backend"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Transferred (All-Time)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rclone_bytes_transferred_total{job=\"rclone\"}",
          "instant": true,
          "legendFormat": "Total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Current Transfers",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "displayMode": "auto", "inspect": false },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "name" },
            "properties": [{ "id": "displayName", "value": "File" }]
          },
          {
            "matcher": { "id": "byName", "options": "size" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "displayName", "value": "Size" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "bytes" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "displayName", "value": "Transferred" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "speed" },
            "properties": [
              { "id": "unit", "value": "Bps" },
              { "id": "displayName", "value": "Speed" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "percentage" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "displayName", "value": "%" },
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "eta" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "displayName", "value": "ETA" }
            ]
          }
        ]
      },
      "options": {
        "footer": { "show": false, "reducer": ["sum"], "fields": "" },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "http://127.0.0.1:6969/core/stats",
          "url_options": { "method": "POST", "data": "" },
          "root_selector": "transferring[*]",
          "columns": [
            { "selector": "name",       "text": "name",       "type": "string" },
            { "selector": "size",       "text": "size",       "type": "number" },
            { "selector": "bytes",      "text": "bytes",      "type": "number" },
            { "selector": "speed",      "text": "speed",      "type": "number" },
            { "selector": "percentage", "text": "percentage", "type": "number" },
            { "selector": "eta",        "text": "eta",        "type": "number" }
          ],
          "filters": [],
          "format": "table",
          "parser": "backend"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transfer Rate",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(rclone_bytes_transferred_total{job=\"rclone\"}[$__rate_interval])",
          "legendFormat": "Transfer rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Files Checked per Action",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(rclone_checked_files_total{job=\"rclone\"}[$__rate_interval])",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Files Transferred",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(rclone_files_transferred_total{job=\"rclone\"}[$__rate_interval])",
          "legendFormat": "Files transferred",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(rclone_files_deleted_on_destination_total{job=\"rclone\"}[$__rate_interval])",
          "legendFormat": "Files deleted (dst)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "rclone Logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"ligma-syslog\", unit=\"rclone-cloud.service\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    }
