{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "versioning": "regex:^(?:amd64-|version-v)?(?<major>\\d+)\\.(?<minor>\\d+)\\.?(?<patch>\\d+)?$",
      "matchPackageNames": [
        "/^lscr\\.io/linuxserver//"
      ]
    },
    {
      "matchPackageNames": ["lscr.io/linuxserver/qbittorrent"],
      "allowedVersions": ">=5.0.0 <6.0.0"
    },
    {
      "matchPackageNames": ["lscr.io/linuxserver/prowlarr"],
      "allowedVersions": ">=2.0.0 <3.0.0"
    },
    {
      "matchPackageNames": ["lscr.io/linuxserver/nzbget"],
      "allowedVersions": "/^version-v/"
    },
    {
      "matchPackageNames": ["ghcr.io/hotio/unpackerr"],
      "versioning": "regex:^release-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "matchPackageNames": ["timescale/timescaledb-ha"],
      "versioning": "regex:^pg18\\.1-ts(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update container image tags in NixOS files annotated with renovate comments",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\n\\s*\\w+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "docker"
    }
  ]
}
