{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "hostRules": [
    {
      "matchHost": "git.deuxfleurs.fr",
      "hostType": "forgejo"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "dxflrs/garage"
      ],
      "sourceUrl": "https://git.deuxfleurs.fr/Deuxfleurs/garage"
    },
    {
      "description": "Docker versioning treats -rc.N as a fixed suffix and never moves to the stable release.",
      "matchPackageNames": [
        "ghcr.io/bigboot/autokuma"
      ],
      "versioning": "semver"
    },
    {
      "versioning": "regex:^(?:amd64-|version-v)?(?<major>\\d+)\\.(?<minor>\\d+)\\.?(?<patch>\\d+)?$",
      "matchPackageNames": [
        "/^linuxserver//"
      ]
    },
    {
      "matchPackageNames": [
        "timescale/timescaledb-ha"
      ],
      "versioning": "regex:^pg18\\.1-ts(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "2026.8.0's published manifest list is broken upstream (podman rejects it: 'Unexpectedly received a manifest list instead of a manifest for a single image'). Block until goauthentik republishes a working 2026.8.x tag — see hosts/ligma/apps/authentik.nix.",
      "matchPackageNames": [
        "ghcr.io/goauthentik/server"
      ],
      "allowedVersions": "!/^2026\\.8\\.0$/"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update container image tags in NixOS files annotated with renovate comments",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\n\\s*\\w+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "docker"
    }
  ]
}